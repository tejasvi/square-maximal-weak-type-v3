theorem generatorPartitionTrees2_valid : ∀ i,
    (generatorPartitionTrees2 i).IsValid (fun p ↦ generatorPartitionRectangles p.1 p.2) := by
  decide +kernel

end PartialBalayage.Maximal.Square
